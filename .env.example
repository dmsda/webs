# ==============================================================================
# Pallet Ross — Environment Configuration Template
# ==============================================================================
# Pallet Ross is a client-side Vite + React application.
# It requires NO private secrets, passwords, or sensitive API keys to run.
#
# If you configure external integrations, copy this file to .env:
#   cp .env.example .env
#
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Branding & Display Title (Optional)
VITE_APP_TITLE="Pallet Ross — Where Art Meets Market"

# Network or Protocol Status Indicator (Optional)
# Default: "Ethereum Mainnet L1"
VITE_NETWORK_NAME="Ethereum Mainnet L1"

# Protocol APY Baseline Display (Optional)
# Default: "4.60%"
VITE_PROTOCOL_APY_BASELINE="4.60%"

# External Gallery Inquiry Endpoint (Optional - e.g. Formspree / Web3Forms)
# Leave empty to use client-side mock submission
VITE_INQUIRY_ENDPOINT=""
